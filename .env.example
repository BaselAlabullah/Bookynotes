# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
# Variables are grouped by the phase that introduces them. A variable is only
# read once its phase exists — src/config/env.public.ts and env.server.ts are
# the only two files that touch process.env, and they validate on startup.
#
# NEXT_PUBLIC_* is inlined into the browser bundle at build time. Never put a
# secret behind that prefix.

# --- Phase 1: application -----------------------------------------------------

# Absolute origin of this deployment, no trailing slash. Used for auth callback
# URLs and page metadata. Locally this is http://localhost:3000; on Vercel it is
# your production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Phase 2: database --------------------------------------------------------

# Postgres connection used at runtime. Supabase dashboard -> Project Settings ->
# Database -> Connection string -> Transaction pooler (port 6543).
# Serverless functions open a new connection per invocation, so the pooler is
# mandatory; the direct connection will exhaust its limit under any real traffic.
# DATABASE_URL=

# Postgres connection used by drizzle-kit for migrations. Same dashboard, but
# the SESSION pooler (aws-<n>-<region>.pooler.supabase.com, port 5432). The
# transaction pooler cannot run the DDL and advisory locks that migrations need.
#
# Specifically the session pooler, not the direct connection: since January 2024
# db.<ref>.supabase.co resolves to IPv6 only unless you pay for the IPv4 add-on,
# and IPv4-only clients (GitHub Actions runners, some home ISPs, some corporate
# networks) cannot reach it at all. Supavisor answers on IPv4.
# DATABASE_MIGRATION_URL=

# --- Phase 3: auth ------------------------------------------------------------

# Supabase dashboard -> Project Settings -> API Keys.
# NEXT_PUBLIC_SUPABASE_URL=

# The "publishable key" (sb_publishable_...). Formerly called the anon key.
# Deliberately public: it ships in the browser bundle. It is only safe because
# RLS is enabled on every table with zero policies, so this key can read
# nothing at all over Supabase's REST endpoint. See DECISIONS 0011 and 0013.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# A "secret key" (sb_secret_...). Formerly called the service_role key. Bypasses
# row level security completely, so it never leaves the backend and never gets a
# NEXT_PUBLIC_ prefix. Not needed until phase 5, where it issues signed storage
# URLs after this app has done its own ownership check.
# SUPABASE_SECRET_KEY=

# --- Phase 5: storage ---------------------------------------------------------

# Name of the private Supabase Storage bucket holding page photographs.
# The bucket must be private: reads go through short-lived signed URLs.
# SUPABASE_STORAGE_BUCKET=page-images

# --- Phase 7: vision model ----------------------------------------------------

# Which implementation of the vision interface to use: "gemini" or "openrouter".
# VISION_PROVIDER=gemini

# Google AI Studio -> Get API key. Free tier, no card required, rate limited per
# minute and per day.
#
# GEMINI_VISION_MODEL defaults to gemini-3.5-flash. Which models a key can reach
# varies by account and changes over time: gemini-2.5-flash is still listed by
# the API but refuses new keys with a 404. Avoid the "-latest" aliases; they are
# a moving target and returned 503 under load while pinned models were fine.
# Check what your key can call before changing this:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" #     https://generativelanguage.googleapis.com/v1beta/models
# GEMINI_VISION_MODEL=gemini-3.5-flash
# GEMINI_API_KEY=

# openrouter.ai -> Keys. Fallback provider; used when VISION_PROVIDER=openrouter.
# OPENROUTER_API_KEY=
# OPENROUTER_VISION_MODEL=
